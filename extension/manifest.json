{
  "manifest_version": 3,

  "name": "Network Anomaly Detector",

  "version": "1.0.0",

  "description": "Real-time browser security interface for the Network Traffic Anomaly Detection system.",

  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Network Anomaly Detector"
  },

  "background": {
    "service_worker": "background/background.js"
  }
}